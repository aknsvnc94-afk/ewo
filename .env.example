# Supabase Proje Ayarları (Supabase Dashboard > Settings > API adresinden alınır)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx   # GİZLİ - sadece sunucu tarafında kullanılır, asla client'a sızdırılmaz

# Basit oturum imzalama anahtarı (rastgele uzun bir metin girin)
SESSION_SECRET=degistirilmesi-gereken-uzun-rastgele-bir-anahtar

# Web Push bildirimleri (VAPID anahtar çifti) — bir kere üretilir, sabit kalır.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY istemci tarafında da kullanıldığı için "NEXT_PUBLIC_" ön eki şart.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxx   # GİZLİ - sadece sunucu tarafında kullanılır
VAPID_SUBJECT=mailto:seninmailin@ornek.com
