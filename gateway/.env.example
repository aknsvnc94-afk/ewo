# Supabase proje ayarlarındaki "Project URL" ve "service_role" anahtarı.
# service_role anahtarı TÜM veriye erişebilir (RLS'i bypass eder) — bu dosyayı
# ASLA git'e eklemeyin, sadece bu bilgisayarda .env adıyla (bu dosyadan kopyalayıp) saklayın.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kaç milisaniyede bir tüm cihazlar taransın (okuma + bekleyen komutları uygulama).
# Çok kısa tutmayın — RS485 hattında çok cihaz varsa haberleşme yavaşlar.
POLL_INTERVAL_MS=10000

# AnKA GLC'nin ölçüm register'larında float32 (ondalıklı) değerler için kelime
# sırası. Cihazın kılavuzunda "byte order" / "word order" ne yazıyorsa ona göre
# ayarlanmalı. Emin değilseniz varsayılanla başlayıp, okunan sıcaklık değeri
# anlamsız çıkarsa (örn. çok büyük bir sayı) diğerini deneyin.
#   big_endian    : yüksek kelime önce (çoğu endüstriyel cihazın varsayılanı)
#   little_endian : düşük kelime önce
FLOAT32_WORD_ORDER=big_endian
